# Copiar este archivo como .streamlit/secrets.toml y ajustar los valores
# segun la instalacion local de Oracle Express XE 18c.

ORACLE_USUARIO = "oscar"
ORACLE_CONTRASENA = "Contrasena.123"  # (contraseña estándar: cámbiala por la tuya)
ORACLE_DSN = "localhost:1521/XEPDB1"

# Direccion de la app usada en el enlace y el QR para inscribirse a una materia.
# - Solo en este PC:            "http://localhost:8501"
# - Celulares en la misma red:  "http://<IP-de-este-PC>:8501"  (ej. http://192.168.1.10:8501)
# - App publicada en internet:  "https://tu-app.streamlit.app"
URL_APP = "http://localhost:8501"
