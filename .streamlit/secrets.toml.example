# Ejemplo público. La contraseña real solo va en secrets.toml (ignorado por Git).
# scripts/preparar_oracle.py genera ese archivo para una instalación nueva.

ORACLE_USUARIO = "UPC_ASISTENCIA"
ORACLE_CONTRASENA = "CAMBIAR_EN_CADA_PC"
ORACLE_DSN = "localhost:1521/XEPDB1"
ORACLE_POOL_MINIMO = 1
ORACLE_POOL_MAXIMO = 10
APP_BASE_URL = "https://localhost:8501"

# Administración: scripts/preparar_administracion.py agrega las credenciales reales.
