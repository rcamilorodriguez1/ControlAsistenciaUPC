# Copiar a deploy/private/secrets.toml EN EL SERVIDOR. Nunca publicar los valores reales.
# APP_HOST de deploy/.env debe ser exactamente este dominio, sin https://.
APP_BASE_URL = "https://aula.su-dominio.edu"
ORACLE_USUARIO = "UPC_ASISTENCIA"
ORACLE_CONTRASENA = "REEMPLAZAR_CLAVE_DEL_ESQUEMA"
# Copiar la cadena TLS de Database Connection, servicio *_low; no la de Oracle XE.
ORACLE_DSN = "tcps://REEMPLAZAR_HOST:1521/REEMPLAZAR_SERVICIO"
ORACLE_TLS_MODO = "tls"
ORACLE_POOL_MINIMO = 1
ORACLE_POOL_MAXIMO = 4
ORACLE_ADMIN_USUARIO = "UPC_ADMIN_APP"
ORACLE_ADMIN_CONTRASENA = "REEMPLAZAR_CLAVE_TECNICA_LIMITADA"
ORACLE_ADMIN_POOL_MINIMO = 0
ORACLE_ADMIN_POOL_MAXIMO = 2
PROFESOR_CLAVE_ALTA = "REEMPLAZAR_AUTORIZACION_PRIVADA"
IDENTIDAD_CLAVE_RUTA = "/app/.local/claves/identidad.key"

# Alternativa mTLS: añadir compose.mtls.yaml, descomprimir wallet en private/wallet,
# sustituir el DSN por el alias *_low de tnsnames.ora y cambiar el modo a "mtls".
# ORACLE_WALLET_DIRECTORIO = "/run/oracle-wallet"
# ORACLE_WALLET_CONTRASENA = "REEMPLAZAR_CLAVE_DEL_WALLET"
